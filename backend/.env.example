JAVA_VERSION=java_version

DB_URL="jdbc:sqlserver://localhost:1433;databaseName=HFS_DB;encrypt=true;trustServerCertificate=true"
DB_USERNAME=sa
DB_PASSWORD=sa
JPA_DDL_AUTO=validate
# Keep false for new databases. See FLYWAY.md before enabling for an existing schema.
FLYWAY_BASELINE_ON_MIGRATE=true

SECRET_KEY=your_base64_secret_key_here
ACCESS_TOKEN_EXPIRATION=1800
REFRESH_TOKEN_EXPIRATION=604800000

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_16_digit_app_password
MAIL_FROM_NAME=Healthy Food System

SEPAY_BANK=
SEPAY_ACCOUNT_NUMBER=
SEPAY_ACCOUNT_NAME=
SEPAY_WEBHOOK_KEY=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=